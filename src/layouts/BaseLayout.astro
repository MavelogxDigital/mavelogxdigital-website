---
/** Bible 11.1 — every page carries its own complete metadata set. No inheritance. */
import { SITE } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/components.css';

interface Props {
  title: string;
  description: string;
  page?: string;              // drives nav active state
  ogImage?: string;
  transparentNav?: boolean;   // true on Home only (5.2)
}
const { title, description, page = '', ogImage = '/og-facebook-whatsapp-linkedin.png',
        transparentNav = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogAbs = new URL(ogImage, SITE.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={SITE.name} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <meta name="theme-color" content="#3BBFA0" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogAbs} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" />

  <!-- 5.3: hash fragments never reach the server; resolve them here. -->
  <script is:inline>
    (function () {
      var map = { '#about':'/about/','#services':'/services/','#portfolio':'/work/',
        '#testimonials':'/work/','#process':'/process/','#contact':'/contact/',
        '#industries':'/services/#industries','#mod-privacy':'/privacy/','#mod-terms':'/terms/' };
      var t = map[location.hash];
      if (t && location.pathname === '/') location.replace(t);
    })();
  </script>
</head>
<body data-page={page}>
  <a class="skip" href="#main">Skip to content</a>
  <Header page={page} transparent={transparentNav} />
  <main id="main"><slot /></main>
  <Footer />

  <script>
    // Reveal on scroll (6.6) — fires once, then unobserves.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll<HTMLElement>('.rv');
    if (reduce) { items.forEach(el => el.classList.add('in')); }
    else {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }
      }, { threshold: 0.12 });
      items.forEach(el => io.observe(el));
    }
    // Nav scroll state (5.2)
    const nav = document.querySelector('.nav');
    if (nav) {
      const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 80);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
    }
  </script>
</body>
</html>
