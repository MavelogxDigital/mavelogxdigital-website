---
import { NAV, SITE } from '../site';
interface Props { page?: string; transparent?: boolean }
const { page = '', transparent = false } = Astro.props;
---
{/* The collapsed menu expands inside the header and pushes the page down,
    rather than sliding over it. Owner decision, 24 Oct 2026, supersedes the
    slide-in overlay panel in 5.2. */}
<header class="nav" data-transparent={transparent ? 'true' : 'false'}>
  <div class="container nav__in">
    {/* Mark plus wordmark. The mark is the four-petal logo, which the palette
        in 6.1 is now sampled from, so the two cannot drift apart. The wordmark
        stays live text rather than part of the image: it keeps its edges at
        any size, it is selectable, and the swept treatment needs real text. */}
    <a class="nav__brand" href="/" aria-label={`${SITE.name}, home`}>
      <picture>
        <source type="image/webp" srcset="/img/mark-petals-64.webp 1x, /img/mark-petals-128.webp 2x" />
        <img class="nav__mark" src="/img/mark-petals-64.png" alt="" width="32" height="32"
             decoding="async" />
      </picture>
      <span class="sweep brandmark">MavelogxDigital</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {NAV.map(i => (
        <a class="nav__link" href={i.href}
           aria-current={page === i.key ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>

    <div class="nav__right">
    <button class="theme-btn" type="button" aria-label="Switch theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
    </button>

    <a class="btn btn--primary nav__cta" href="/contact/">Start a Project</a>

    <button class="nav__burger" type="button"
            aria-expanded="false" aria-controls="navpanel">
      <svg class="i-open" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="i-close" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>
      </svg>
      <span class="nav__burger-label">Menu</span>
    </button>
    </div>
  </div>

  <div class="nav__panel" id="navpanel" data-open="false">
    <div class="nav__panel-clip">
      <div class="container nav__panel-in">
        <nav class="nav__panel-links" aria-label="Menu">
          {NAV.map(i => (
            <a href={i.href} aria-current={page === i.key ? 'page' : undefined}>{i.label}</a>
          ))}
        </nav>
        <a class="btn btn--primary nav__panel-cta" href="/contact/">Start a Project</a>
      </div>
    </div>
  </div>
</header>

<script>
  /* Disclosure, not a modal. The menu expands in the header and pushes the
     page down, so the content beneath stays visible and reachable. That rules
     out a focus trap, which belongs to overlays. Escape still closes, and
     focus returns to the control. */
  const nav    = document.querySelector<HTMLElement>('.nav');
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const panel  = document.querySelector<HTMLElement>('.nav__panel');

  if (nav && burger && panel) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      panel.dataset.open = String(open);
      nav.classList.toggle('is-menu-open', open);
      // Opening returns the page to the top, so the menu always pushes the
      // content down instead of covering it once the header is pinned.
      if (open) window.scrollTo({ top: 0 });
      else burger.focus();
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true'));

    // Same-page anchors do not reload, so close on any link in the panel.
    panel.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.dataset.open === 'true') setOpen(false);
    });
  }
</script>
